<%- include('partials/header', { title: 'Shelters & Breeders - Animal Marketplace' }) %>

<!-- Page Header -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="h3 mb-0">Shelters & Breeders</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">Shelters & Breeders</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <!-- Filter Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-pills justify-content-center">
                <li class="nav-item">
                    <a class="nav-link active" href="#all" data-filter="all">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#shelters" data-filter="shelter">Animal Shelters</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#breeders" data-filter="breeder">Breeders</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Shelters Grid -->
    <div class="row g-4">
        <% shelters.forEach(shelter => { %>
            <div class="col-lg-6 shelter-card" data-type="<%= shelter.type %>">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="flex-grow-1">
                                        <h5 class="card-title mb-1"><%= shelter.name %></h5>
                                        <div class="mb-2">
                                            <% if (shelter.type === 'shelter') { %>
                                                <span class="badge bg-success me-2">
                                                    <i class="fas fa-home me-1"></i>Animal Shelter
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-primary me-2">
                                                    <i class="fas fa-award me-1"></i>Professional Breeder
                                                </span>
                                            <% } %>
                                        </div>
                                        
                                        <!-- Rating -->
                                        <div class="mb-2">
                                            <% for (let i = 0; i < 5; i++) { %>
                                                <i class="fas fa-star <%= i < Math.floor(shelter.rating) ? 'text-warning' : 'text-muted' %>"></i>
                                            <% } %>
                                            <span class="ms-2 text-muted">
                                                <%= shelter.rating %> (<%= shelter.reviews %> reviews)
                                            </span>
                                        </div>
                                        
                                        <!-- Location -->
                                        <p class="text-muted mb-2">
                                            <i class="fas fa-map-marker-alt me-1"></i><%= shelter.city %>
                                        </p>
                                        
                                        <!-- Description -->
                                        <p class="card-text text-muted"><%= shelter.description %></p>
                                    </div>
                                </div>
                                
                                <!-- Stats -->
                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <div class="text-center p-2 bg-light rounded">
                                            <h6 class="mb-0">0</h6>
                                            <small class="text-muted">Available Animals</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-center p-2 bg-light rounded">
                                            <h6 class="mb-0">0</h6>
                                            <small class="text-muted">Successful Adoptions</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4 text-center">
                                <!-- Placeholder for shelter logo/image -->
                                <div class="bg-light rounded p-4 mb-3" style="height: 120px; display: flex; align-items: center; justify-content: center;">
                                    <% if (shelter.type === 'shelter') { %>
                                        <i class="fas fa-home fa-3x text-muted"></i>
                                    <% } else { %>
                                        <i class="fas fa-award fa-3x text-muted"></i>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer bg-transparent">
                        <div class="row g-2">
                            <div class="col-6">
                                <a href="/shelter/<%= shelter.id %>" class="btn btn-primary w-100">
                                    <i class="fas fa-eye me-1"></i>View Profile
                                </a>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-outline-primary w-100">
                                    <i class="fas fa-envelope me-1"></i>Contact
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>

    <!-- Empty State -->
    <% if (shelters.length === 0) { %>
        <div class="text-center py-5">
            <i class="fas fa-home fa-3x text-muted mb-3"></i>
            <h4>No shelters or breeders found</h4>
            <p class="text-muted">Check back later for new listings.</p>
        </div>
    <% } %>

    <!-- Call to Action -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body text-center py-5">
                    <h3 class="mb-3">Are you a shelter or breeder?</h3>
                    <p class="lead mb-4">Join our platform to help more animals find loving homes.</p>
                    <a href="/register" class="btn btn-light btn-lg">
                        <i class="fas fa-plus me-2"></i>Join Our Platform
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Filter functionality
document.querySelectorAll('[data-filter]').forEach(button => {
    button.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Update active tab
        document.querySelectorAll('[data-filter]').forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        
        // Filter cards
        const filter = this.dataset.filter;
        document.querySelectorAll('.shelter-card').forEach(card => {
            if (filter === 'all' || card.dataset.type === filter) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    });
});
</script>
<%- include('partials/footer') %>