<!DOCTYPE html>
<html lang="<%= lang === 'ru' ? 'ru' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || (lang === 'ru' ? 'Рынок Животных' : 'Animal Marketplace') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="/">
                <i class="fas fa-paw me-2"></i><%= lang === 'ru' ? 'РынокЖивотных' : 'AnimalMarket' %>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><%= lang === 'ru' ? 'Главная' : 'Home' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/catalog"><%= lang === 'ru' ? 'Животные' : 'Browse Animals' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shelters"><%= lang === 'ru' ? 'Приюты' : 'Shelters & Breeders' %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/feedback"><%= lang === 'ru' ? 'Отзывы' : 'Feedback' %></a>
                    </li>
                </ul>
                
                <ul class="navbar-nav">
                    <!-- Language Switcher -->
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-globe me-1"></i><%= lang === 'ru' ? 'Русский' : 'English' %>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/lang/en">🇺🇸 English</a></li>
                            <li><a class="dropdown-item" href="/lang/ru">🇷🇺 Русский</a></li>
                        </ul>
                    </li>
                    
                    <% if (user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                <% if (user.avatar) { %>
                                    <img src="<%= user.avatar %>" alt="<%= user.name %>" class="rounded-circle me-1" style="width: 24px; height: 24px;">
                                <% } else { %>
                                    <i class="fas fa-user me-1"></i>
                                <% } %>
                                <%= user.name %>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/dashboard">
                                    <i class="fas fa-tachometer-alt me-2"></i><%= lang === 'ru' ? 'Панель управления' : 'Dashboard' %>
                                </a></li>
                                <li><a class="dropdown-item" href="/add-animal">
                                    <i class="fas fa-plus me-2"></i><%= lang === 'ru' ? 'Добавить животное' : 'Add Animal' %>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/logout">
                                    <i class="fas fa-sign-out-alt me-2"></i><%= lang === 'ru' ? 'Выйти' : 'Logout' %>
                                </a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login"><%= lang === 'ru' ? 'Войти' : 'Login' %></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary text-white ms-2 px-3" href="/register">
                                <%= lang === 'ru' ? 'Регистрация' : 'Sign Up' %>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>